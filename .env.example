# Application
APP_NAME="Tara Guest House"
APP_ENV=local
APP_DEBUG=false
# Staging and production require an HTTPS origin with no path, query, fragment, or credentials.
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kathmandu
APP_KEY=

# Database
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=tara_guest_house
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_TIMEZONE=+00:00
DB_CONNECT_TIMEOUT=5
DB_SSL_CA=

# Isolated automated-test database
TEST_DB_DRIVER=mysql
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3307
TEST_DB_DATABASE=tara_guest_house_test
TEST_DB_USERNAME=
TEST_DB_PASSWORD=
TEST_DB_CHARSET=utf8mb4
TEST_DB_COLLATION=utf8mb4_unicode_ci
TEST_DB_TIMEZONE=+00:00
TEST_DB_CONNECT_TIMEOUT=5
TEST_DB_SSL_CA=

# Session
SESSION_NAME=tgh_session
SESSION_INACTIVITY_TIMEOUT=1800
SESSION_ABSOLUTE_LIFETIME=43200
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax
SESSION_PATH=/
SESSION_DOMAIN=

# Logging
LOG_CHANNEL=file
LOG_LEVEL=debug
LOG_PATH=storage/logs/application.log

# Transactional email
# MAIL_HOST may be blank only in local/testing. Staging/production fail closed.
# Staging/production require MAIL_ENCRYPTION=tls or ssl; none is local/testing only.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Tara Guest House"
MAIL_REPLY_TO_ADDRESS=
MAIL_REPLY_TO_NAME=
MAIL_TIMEOUT=10

# Business and upload policy
# Pending Guest bookings remain blocking for six hours.
BOOKING_PENDING_DEADLINE_MINUTES=360
# Generate a separate random secret of at least 32 bytes for booking follow-up tokens.
BOOKING_ACCESS_TOKEN_KEY=
# Approval required: maximum upload size in bytes.
UPLOAD_MAX_BYTES=

# Gallery upload decision gate. Leave these empty until the exact policy is approved.
# Supported format tokens are jpeg, png and webp, supplied as a comma-separated list.
GALLERY_IMAGE_FORMATS=
GALLERY_IMAGE_MAX_BYTES=
GALLERY_IMAGE_MIN_WIDTH=
GALLERY_IMAGE_MIN_HEIGHT=
GALLERY_IMAGE_MAX_WIDTH=
GALLERY_IMAGE_MAX_HEIGHT=
GALLERY_IMAGE_REQUIRE_DECODABILITY=

# Required before CMS settings can be managed. JSON object keyed by approved setting key.
# Each definition must contain value_type, is_public and maximum_length.
CMS_SETTING_DEFINITIONS_JSON={"site.name":{"value_type":"string","is_public":true,"maximum_length":120},"site.tagline":{"value_type":"string","is_public":true,"maximum_length":180},"site.description":{"value_type":"string","is_public":true,"maximum_length":800},"site.logo":{"value_type":"relative_path","is_public":true,"maximum_length":255},"site.logo.enabled":{"value_type":"boolean","is_public":true,"maximum_length":5},"site.timezone":{"value_type":"string","is_public":false,"maximum_length":80},"site.currency":{"value_type":"string","is_public":true,"maximum_length":3},"contact.email":{"value_type":"email","is_public":true,"maximum_length":254},"contact.phone":{"value_type":"string","is_public":true,"maximum_length":40},"contact.whatsapp":{"value_type":"string","is_public":true,"maximum_length":40},"contact.address":{"value_type":"string","is_public":true,"maximum_length":500},"contact.maps":{"value_type":"url","is_public":true,"maximum_length":2000},"social.facebook":{"value_type":"url","is_public":true,"maximum_length":2000},"social.instagram":{"value_type":"url","is_public":true,"maximum_length":2000},"social.youtube":{"value_type":"url","is_public":true,"maximum_length":2000},"social.tiktok":{"value_type":"url","is_public":true,"maximum_length":2000},"guest.checkin":{"value_type":"string","is_public":true,"maximum_length":120},"guest.checkout":{"value_type":"string","is_public":true,"maximum_length":120},"guest.reception":{"value_type":"string","is_public":true,"maximum_length":180},"guest.emergency":{"value_type":"string","is_public":true,"maximum_length":40},"seo.title":{"value_type":"string","is_public":true,"maximum_length":160},"seo.description":{"value_type":"string","is_public":true,"maximum_length":320},"footer.description":{"value_type":"string","is_public":true,"maximum_length":500},"footer.copyright":{"value_type":"string","is_public":true,"maximum_length":240},"notification.contact":{"value_type":"email","is_public":false,"maximum_length":254},"notification.booking":{"value_type":"email","is_public":false,"maximum_length":254},"notification.review":{"value_type":"email","is_public":false,"maximum_length":254}}
CMS_PAGE_CONTENT_POLICY_JSON=

# Required before verified-stay review invitations can be issued.
# Supply the formally approved invitation lifetime in whole seconds.
REVIEW_INVITATION_LIFETIME_SECONDS=
REVIEW_MODERATION_NOTE_MAXIMUM_CHARACTERS=
