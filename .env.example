# Application
APP_NAME="Tara Guest House"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kathmandu
APP_KEY=

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tara_guest_house
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_SSL_CA=

# Session
SESSION_NAME=tgh_session
SESSION_INACTIVITY_TIMEOUT=1800
SESSION_ABSOLUTE_LIFETIME=43200
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax
SESSION_PATH=/
SESSION_DOMAIN=

# Logging
LOG_CHANNEL=file
LOG_LEVEL=debug
LOG_PATH=storage/logs/application.log

# Transactional email
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Tara Guest House"
MAIL_REPLY_TO_ADDRESS=
MAIL_REPLY_TO_NAME=
MAIL_TIMEOUT=10

# Business and upload policy
# Approval required: pending-booking deadline in minutes.
BOOKING_PENDING_DEADLINE_MINUTES=
# Approval required: maximum upload size in bytes.
UPLOAD_MAX_BYTES=
