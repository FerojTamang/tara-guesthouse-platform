Options -Indexes

<FilesMatch "\.(?i:php(?:[0-9]+|s)?|phtml|pht|phar|cgi|pl|py|sh|bash|exe|com|bat|cmd|ps1)$">
    Require all denied
</FilesMatch>

<IfModule mod_mime.c>
    RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .pht .phar .cgi .pl .py .sh .bash
    RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .pht .phar .cgi .pl .py .sh .bash
</IfModule>
